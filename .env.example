# AI_translate 環境變數樣板
# 1. 複製此檔為 .env（位於專案根目錄，已被 git 忽略）
# 2. 填入自己的 Postgres 帳密
# 3. 執行 .\dc.bat 啟動
#
# 注意：Google Gemini API 金鑰「不是」放這裡，而是啟動後在前端「設定 (Settings)」
#       頁面填入，儲存於資料庫。DATABASE_URL / REDIS_HOST 由 docker-compose 自動注入。

# --- PostgreSQL（必填）---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcription_db

# --- 選填調校（留空即用預設值）---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# 單檔轉錄可接受的最大時長（秒）；超過且失敗時改走 VAD 分割重試
# TRANSCRIPTION_MAX_DURATION_SECONDS=180
# Batch / Flex 推論費用折扣率（0.5 = 半價）
# BATCH_COST_DISCOUNT=0.5
# FLEX_COST_DISCOUNT=0.5
# 語音佔比 >= 此值時跳過 VAD（0.9 = 空白超過 10% 才做 VAD）
# VAD_SPEECH_RATIO_SKIP_THRESHOLD=0.90
# 超過此時長（秒）的音檔（VAD 之後）轉錄前在中點靜音處對半切；0 = 停用
# LONG_AUDIO_SPLIT_THRESHOLD_SECONDS=900
# 保留 VAD 切割產物供試聽（除錯用）
# VAD_KEEP_ARTIFACTS=true
# 允許跨來源呼叫 API／連 WebSocket 的前端來源（逗號分隔；預設只含 Vite dev server）。
# 從區網其他電腦開 http://<本機IP>:5173 時，要把那個網址加進來
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
