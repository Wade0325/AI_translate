# AI_translate 環境變數樣板
# 1. 複製此檔為 .env（位於專案根目錄，已被 git 忽略）
# 2. 填入自己的 Postgres 帳密
# 3. 執行 .\dc.bat 啟動
# 免安裝模式（含免安裝版）只讀資料目錄（data\）的 .env，專案根目錄的 .env 對它無效。
#
# 注意：Google Gemini API 金鑰「不是」放這裡，而是啟動後在前端「設定 (Settings)」
#       頁面填入，儲存於資料庫。DATABASE_URL / REDIS_HOST 由 docker-compose 自動注入。

# --- PostgreSQL（必填）---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=transcription_db

# --- 選填調校（留空即用預設值）---
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# 單檔轉錄可接受的最大時長（秒）；超過且失敗時改用分段轉錄重試（只用於 Gemini）
# TRANSCRIPTION_MAX_DURATION_SECONDS=180
# Batch / Flex 推論費用折扣率（0.5 = 半價）
# BATCH_COST_DISCOUNT=0.5
# FLEX_COST_DISCOUNT=0.5
# 語音佔比 >= 此值時不去靜音，直接用原檔轉錄（0.9 = 空白超過 10% 才去靜音）
# VAD_SPEECH_RATIO_SKIP_THRESHOLD=0.90
# Gemini 與本機的 vibevoice-qwen3-asr 的分段轉錄門檻（秒）：去靜音之後（沒去靜音就是原檔）
# 仍超過此時長的音檔，轉錄前先在最接近中點的靜音處切開，直到每段都不超過此值；0 = 不分段轉錄。
# MOSS 模型不看這一項，看 LOCAL_MOSS_SINGLE_PASS_MAX_SECONDS
# LONG_AUDIO_SPLIT_THRESHOLD_SECONDS=900
# 本機的 MOSS 模型（moss-align、moss-qwen3-asr）的分段轉錄門檻（秒）：整檔一次處理，說話者編號
# 才會前後一致。實際門檻還會依模型上限與顯卡記憶體下修；0 = 不分段轉錄（太長的音檔可能掉尾或失敗）
# LOCAL_MOSS_SINGLE_PASS_MAX_SECONDS=4200
# 本機的模型權重存放的資料夾（Hugging Face 的 HF_HOME），要改時填完整路徑；
# 免安裝版與 local_worker.bat 會自己設定，不看這個值
# HF_HOME=
# 保留去靜音與切點的產物供試聽（除錯用）
# VAD_KEEP_ARTIFACTS=true
# 任務結束後把音檔留在電腦上（保留音檔），校正介面才能重播；false = 任務結束就刪掉音檔
# RETAIN_AUDIO=true
# 保留音檔留幾天，過期的在後端啟動時刪除；0 = 不自動刪除
# AUDIO_RETENTION_DAYS=30
# 單檔任務送出超過此時數仍在處理中，就當作 worker 已中斷，後端啟動時改標為失敗；要長於最久的
# 轉錄時間（本機轉錄長檔可達數小時）。免安裝模式啟動時一律全部改標，不看這個值
# STALE_PROCESSING_MAX_AGE_HOURS=12
# 允許跨來源呼叫 API／連 WebSocket 的前端來源（逗號分隔；預設只含 Vite dev server）。
# 從區網其他電腦開 http://<本機IP>:5173 時，要把那個網址加進來
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
