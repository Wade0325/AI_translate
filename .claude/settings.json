{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect_paths.py",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "檢查保護路徑..."
          }
        ]
      }
    ]
  }
}
